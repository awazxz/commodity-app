DROP TABLE IF EXISTS `andil_inflasi_bulanan`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `andil_inflasi_bulanan` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `komoditas_id` bigint(20) unsigned NOT NULL,
  `tanggal` date NOT NULL,
  `nilai_rh` decimal(12,6) NOT NULL,
  `nilai_nk_komoditas` decimal(30,6) DEFAULT NULL,
  `nilai_ihk_komoditas` decimal(12,6) NOT NULL,
  `bobot_dinamis` decimal(12,6) NOT NULL,
  `inflasi_mtom_komoditas` decimal(10,6) DEFAULT NULL,
  `andil_mtom` decimal(12,6) DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_andil` (`komoditas_id`,`tanggal`),
  CONSTRAINT `andil_inflasi_bulanan_ibfk_1` FOREIGN KEY (`komoditas_id`) REFERENCES `master_komoditas` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=1891 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;
