DROP TABLE IF EXISTS `ihk_bulanan`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `ihk_bulanan` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `tanggal` date NOT NULL,
  `nilai_ihk` decimal(10,6) NOT NULL,
  `inflasi` decimal(10,6) DEFAULT NULL,
  `inflasi_ytd` decimal(10,6) DEFAULT NULL COMMENT 'Y-to-D: vs Desember tahun lalu',
  `inflasi_yoy` decimal(10,6) DEFAULT NULL COMMENT 'Y-on-Y: vs bulan sama tahun lalu',
  `kondisi` enum('inflasi','deflasi','stabil') DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_tanggal` (`tanggal`)
) ENGINE=InnoDB AUTO_INCREMENT=130 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

