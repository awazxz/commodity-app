# ─────────────────────────────────────────────
# .env — Flask Forecasting Server
# ─────────────────────────────────────────────

FLASK_PORT=5000
FLASK_ENV=production

# DB (sesuaikan dengan konfigurasi servermu)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=commodityapp
DB_USER=root
DB_PASSWORD=

# ─────────────────────────────────────────────
# API KEY — v8.4 Security
# Gunakan nilai yang SAMA persis di .env Laravel
# Ganti nilai di bawah dengan key milikmu sendiri
# Generate baru: python3 -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────
FLASK_API_KEY=GANTI_DENGAN_KEY_YANG_KAMU_GENERATE
